{
  "mcpServers": {
    "repowise": {
      "command": "repowise",
      "args": [
        "mcp",
        "C:/Users/HSA19/antigravity/Missense-Structural-Explorer",
        "--transport",
        "stdio"
      ],
      "description": "repowise: codebase intelligence \u2014 docs, graph, git signals, dead code, decisions"
    },
    "graphify": {
      "command": "uv",
      "args": [
        "run",
        "--with",
        "graphifyy",
        "--with",
        "mcp",
        "-m",
        "graphify.serve",
        "C:/Users/HSA19/antigravity/Missense-Structural-Explorer/graphify-out/graph.json"
      ],
      "description": "graphify: AST code knowledge graph \u2014 symbol traversal, architecture communities, caller graphs"
    },
    "graft": {
      "command": "node",
      "args": [
        "tools/agent-tooling/cli.cjs",
        "graft",
        "mcp",
        "C:/Users/HSA19/antigravity/Missense-Structural-Explorer"
      ],
      "description": "graft: AST codebase graph \u2014 symbol wiring, call hierarchies, skeletons, and architecture maps"
    },
    "e2e": {
      "command": "npx",
      "args": [
        "e2e",
        "mcp"
      ]
    }
  }
}
