# Missense & Fold Reverse Proxy and TLS Configuration
# Run via: caddy run --config Caddyfile

localhost {
    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Set security headers
    header {
        # Enable HTTP Strict Transport Security (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent browsers from sniffing MIME types
        X-Content-Type-Options "nosniff"
        # Protect against cross-site scripting (XSS)
        X-XSS-Protection "1; mode=block"
        # Content Security Policy (M-6, P3-4)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.ebi.ac.uk https://alphafold.ebi.ac.uk https://*.uniprot.org https://myvariant.info https://*.rcsb.org;"
        # Frame protection
        X-Frame-Options "DENY"
    }

    # Enable gzip/zstd compression
    encode zstd gzip
}
