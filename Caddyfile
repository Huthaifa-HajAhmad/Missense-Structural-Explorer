# Missense & Fold Reverse Proxy and TLS Configuration
# Run via: caddy run --config Caddyfile

{
    # Runtime errors include request headers too. Filter the default logger, not only access logs.
    log default {
        format filter {
            wrap json
            fields {
                request>headers delete
            }
        }
    }
}

missense-resolve.duckdns.org {
    respond /internal/* 404
    reverse_proxy missense-resolve-app:3000 {
        # Existing streams retain their old upstream while its requests and jobs drain.
        stream_close_delay 35m
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Set security headers
    header {
        # Enable HTTP Strict Transport Security (HSTS)
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Prevent browsers from sniffing MIME types
        X-Content-Type-Options "nosniff"
        # Protect against cross-site scripting (XSS)
        X-XSS-Protection "1; mode=block"

        # Frame protection
        X-Frame-Options "DENY"
    }

    # Enable gzip/zstd compression
    encode zstd gzip
}
