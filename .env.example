# ============================================================
# INTERNAL LAB TOOL — replace ALL placeholder values before
# setting NODE_ENV=production. See doc/DEPLOY.md for the
# full onboarding checklist.
# ============================================================

# GEMINI_API_KEY: Optional; enables AI synthesis, not core evidence or classification.
# Leave blank for a keyless workspace. Obtain a key at https://aistudio.google.com/app/apikey
# AI synthesis can also be Off or On demand in Settings > Analysis.
GEMINI_API_KEY=""

# GEMINI_MODEL: Primary Gemini model to use for analysis.
# Defaults to gemini-3.6-flash if not set (gemini-3.7-flash and gemini-3.5-flash are
# deprecated per https://ai.google.dev/gemini-api/docs/deprecations, checked 2026-10-10).
# It is only the ladder's tie-break: the request round-robins every configured
# candidate, so pinning a model does not restrict which ones are tried.
# GEMINI_MODEL="gemini-3.6-flash"

# GEMINI_MODEL_FALLBACKS: Comma-separated list of fallback models tried in
# order if the primary model fails (e.g. quota exceeded or unavailable).
#
# Leave this UNSET. The shipped ladder is ordered by measured reliability and
# latency and is the one the 105s synthesis budget is sized against; setting a
# list here replaces it wholesale. A copied-from-here list previously led with
# models that answer 503/504 and ended with two the API has retired (404), which
# is the configuration that produced "Not synthesized" reports.
# GEMINI_MODEL_FALLBACKS=""

# FOLDX_BINARY: Absolute path to the FoldX 5.x executable on this host.
# Leave blank to auto-detect from tools/foldx/foldx*.exe
# FoldX is license-bound — do NOT commit the binary to git.
# Download from https://foldxsuite.crg.eu/
FOLDX_BINARY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_API_TOKEN: Secret key used to authenticate client requests.
# Enforced fail-closed in production if not set.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
APP_API_TOKEN="a_secure_arbitrary_api_token"

# ── Accounts (doc/COMPUTE_ROUTING_PLAN.md, section 4) ─────────────────────────────
# AUTH_MODE: legacy (today's behaviour) -> hybrid (writes need a sign-in OR APP_API_TOKEN)
#            -> accounts (writes need a sign-in; APP_API_TOKEN is read-only). Roll back by
#            setting it back and restarting.
AUTH_MODE="legacy"
# AUTH_PROVIDER: password is the only provider built (the app's own invite-only login).
AUTH_PROVIDER="password"
# ADMIN_SETUP_SECRET: enables the one-time /setup page that creates the first admin, and only
# while no account exists. 16+ characters. You can remove it once the first admin exists.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# ADMIN_SETUP_SECRET=""
# PUBLIC_BASE_URL: the address used in invite and reset links.
# PUBLIC_BASE_URL="https://missense-resolve.duckdns.org"
# ACCOUNTS_DB_PATH="data/accounts.sqlite"
# SESSION_TTL_DAYS="14"        # a sign-in lasts at most this long
# SESSION_IDLE_HOURS="24"      # ...and ends sooner after this long unused
# QUOTA_QUEUED_PER_USER="25"   # waiting jobs per person WHILE OTHERS WAIT TOO; alone, up to QUEUE_MAX_TOTAL - 5
# QUEUE_MAX_TOTAL="50"          # waiting + running across everyone: the host-wide backstop
# COMPUTE_ROUTING="shadow"     # off | shadow (log what the placement engine would decide) | on (refuse jobs that cannot run here, 422, and place jobs on the owner's own computer when it should finish first)
# QUOTA_SERVER_SECONDS_PER_DAY=""  # unset = no daily cap (the default)
# BIOPHYSICAL_CONCURRENCY="4"  # jobs running at once. UNSET: FoldX also stays at or below CPUs - 1 (1 on the 2-core server). SET: FoldX gets exactly this value too, so 4 on that host means 4 Box64 FoldX at once.
# JOB_RETENTION_DAYS="14"         # finished jobs are deleted after this long
# TELEMETRY_RETENTION_DAYS="180"  # job timing records (wait estimates) are deleted after this long
# Placement-engine tunables (src/shared/computeRouting.ts). A bad value is logged and the default used.
# COST_MODEL_MIN_SAMPLES="8"      # finished jobs a machine class needs before its measured curve replaces the prior
# ROUTING_RAM_HEADROOM="1.25"     # predicted peak memory is multiplied by this before it is compared with free memory
# ROUTING_TIE_MARGIN="0.2"        # two hosts whose expected finish times differ by at most this fraction are a tie
# Paired computers ("agents", doc/AGENT.md). All optional.
# AGENT_LEASE_SEC="60"            # a computer's job goes back to the server if not renewed for this long
# AGENT_HEARTBEAT_SEC="20"        # how often a computer renews it
# TOOL_BUNDLES_DIR="data/tool-bundles"   # the team FoldX bundle an admin uploads (Settings -> Team)
# AGENT_BUNDLE_DIR="data/agent-bundles"  # agent zips offered in Settings -> Account (npm run build:agent-bundle)
# AGENT_ACCEPTED_FOLDX_VERSIONS=""       # e.g. "5.1"; unset = any well-formed version (it is part of the cache key anyway)
# AGENT_ACCEPTED_P2RANK_VERSIONS=""
# Remote providers (doc/COMPUTE_ROUTING_PLAN.md WP-I). The team shares one server IP.
# EGRESS_GOVERNOR="off"           # off | shadow (log and show on /capabilities the 429 pauses and the fair-share waits it would apply) | on (a 429, or 503 with Retry-After, pauses that provider for everyone for Retry-After, 5 s if absent, at most 10 s, and does not count toward the circuit breaker; calls to each provider take turns between signed-in people, prewarm last; Ensembl and NCBI are also held to their published rates, every other provider to 5 calls at a time; a lookup that fails because a provider is limiting requests is answered from the saved copy, even if expired, and the reader is told its age)
# EGRESS_PROVIDER_LIMITS_JSON=""   # optional per-provider override, e.g. '{"ensembl":{"ratePerMin":600},"rest.uniprot.org":{"maxConcurrent":3}}' (keys: registry id or hostname; maxConcurrent, ratePerMin, burst). A bad value is logged and ignored.
# Applying a change on the production server: doc/ACCOUNTS.md, "Applying a setting".

# ALLOWED_ORIGINS: Comma-separated list of allowed origins for CORS.
# Defaults to http://localhost:3000 if not set.
ALLOWED_ORIGINS="http://localhost:3000"

# NODE_ENV: Set to 'production' to enable fail-closed API token checks,
# strict CSP headers, and other production optimizations.
NODE_ENV="development"

# APP_SESSION_SECRET: Secret key used to encrypt/decrypt session key tokens (AES-GCM).
# Require 32+ random characters. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET="dev_session_secret_must_be_changed_in_prod_32_bytes_long"

# CACHE_IDENTITY_SALT: Optional stable, private HMAC key for persisted custom-provider
# endpoint identities. Falls back to APP_SESSION_SECRET, then an in-process random key.
# It is NOT an authentication/authorization token. Rotating it invalidates custom-endpoint cache
# identities; omitting both stable keys makes custom-endpoint rows cold after a restart.
# Leave blank to use APP_SESSION_SECRET. Never copy an API credential into this field.
CACHE_IDENTITY_SALT=""

# PREWARM_FOLDX_ENABLED: Speculative FoldX warming is OFF unless exactly "true".
# Requires canonical numbering and matching native defaults (7.0 pH, 298 K, 0.05 M).
# These differ from the UI defaults (7.4 pH, 25 C, 150 mM); do not enable to warm mismatched runs.
# In-flight sharing is process-local; this flag does not guarantee deduplication across replicas.
PREWARM_FOLDX_ENABLED="false"

# GENOS_EMAIL: Academic email used to log in to Genos US query API.
GENOS_EMAIL="academic_email_here"

# GENOS_ACCESS_KEY: Genos US access key corresponding to the email.
GENOS_ACCESS_KEY="access_key_here"

# SIDECAR_SECRET: Secret key for sidecar inter-process authentication.
# Leave blank to automatically generate a random UUID key in-memory at startup.
SIDECAR_SECRET=""

# BIOHUB_API_TOKEN: Optional token used to authenticate requests to the BioHub ESM3 API.
BIOHUB_API_TOKEN="your_biohub_api_token_here"
