# ==============================================================================
# Stage 1: Build Box64 (x86_64 emulator for ARM64 Linux) from source
# ==============================================================================
FROM debian:bookworm-slim AS box64-builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    cmake \
    python3 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --branch v0.4.4 https://github.com/ptitSeb/box64.git box64 && \
    mkdir -p box64/build && \
    cd box64/build && \
    cmake .. -DARM_DYNAREC=ON -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc)

# ==============================================================================
# Stage 2: Build Node.js Application & Python Virtual Environment
# ==============================================================================
FROM node:22-bookworm-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Copy Node dependency definitions & install with BuildKit npm cache
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# Copy Python dependency lockfiles & build venv with BuildKit uv cache.
#
# Every remaining git source in tools/uv.lock must be anonymously fetchable: this build
# has no GitHub credential, because a private source here fails the image build with
# "could not read Username for 'https://github.com'" and the deployment never starts.
# `transformers` was resolved from the private Biohub fork until tools/pyproject.toml
# pinned it back to PyPI via `override-dependencies`; keep it that way, or supply a
# token as a build secret before reintroducing a private source.
COPY tools/pyproject.toml tools/uv.lock ./tools/
ENV UV_LINK_MODE=copy
ENV UV_COMPILE_BYTECODE=1
RUN --mount=type=cache,target=/root/.cache/uv \
    uv python install 3.12 && uv sync --project tools --no-dev --python 3.12

# Copy source tree
COPY . .

# Run quick verification gates (TypeScript type-check)
RUN npm run lint

# Compile React frontend (Vite) and Node.js backend (esbuild)
RUN npm run build

# ==============================================================================
# Stage 3: Production Runner (ARM64 Optimized)
# ==============================================================================
FROM node:22-bookworm-slim AS runner

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    git \
    libgomp1 \
    procps \
    curl \
    ca-certificates \
    default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# Copy standalone Python interpreters and runtimes managed by uv
COPY --from=builder /root/.local/share/uv /root/.local/share/uv

# Copy Box64 binary from builder stage into system bin
COPY --from=box64-builder /src/box64/build/box64 /usr/local/bin/box64
RUN chmod +x /usr/local/bin/box64

ENV NODE_ENV=production
ENV PORT=3000
ENV HF_HOME=/root/.cache/huggingface
ENV PATH="/app/tools/.venv/bin:$PATH"

# 1. Install production Node dependencies (cached unless package.json changes)
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev

# 2. Copy heavy Python tools and virtual environment BEFORE app code (cached unless tools change)
COPY tools/ ./tools/
COPY --from=builder /app/tools/.venv ./tools/.venv
RUN find /app/tools -type f \( -name "prank" -o -name "*.sh" -o -name "foldx*" \) -exec chmod +x {} + 2>/dev/null || true

# 3. Copy SQLite data seeds and documentation
COPY --from=builder /app/data ./data/
COPY README.md ./

# 4. Create persistent cache and log directories
RUN mkdir -p /app/logs/foldx_cache /root/.cache/huggingface /app/data

# 5. Copy lightweight compiled distribution bundles LAST so code edits never invalidate Python layers
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/server/services/alphagenome/protos ./server/services/alphagenome/protos

# Declare volume mounts
VOLUME ["/app/data", "/app/tools/foldx", "/app/logs", "/root/.cache/huggingface"]

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD curl -f http://localhost:3000/api/v1/health || exit 1

CMD ["npm", "run", "start"]
