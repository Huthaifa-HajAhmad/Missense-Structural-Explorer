{
  "name": "missense-resolve",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:workers": "esbuild server/workers/structural-diff-worker.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/structural-diff-worker.cjs && esbuild server/workers/analysis-db-worker.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/analysis-db-worker.cjs",
    "build:protos": "node -e \"require('fs').cpSync('server/services/alphagenome/protos','dist/alphagenome/protos',{recursive:true})\"",
    "build": "npm run build:client && npm run build:server && npm run build:workers && npm run build:protos",
    "start": "node dist/server.cjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsx scripts/check-boundaries.ts && node scripts/check-focus-indicators.mjs && tsx scripts/check-verify-parity.ts && tsc --noEmit",
    "audit": "npm audit --audit-level=critical",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run server/tests/smoke.test.ts",
    "test:canary": "vitest run server/tests/canary.test.ts",
    "test:canary:live": "tsx scripts/canary-check.ts",
    "test:geometry": "node tools/header-geometry/check.mjs",
    "test:geometry:function-track": "node tools/function-track-geometry/check.mjs",
    "verify:geometry": "npm run test:geometry && npm run test:geometry:function-track",
    "verify": "npm run lint && npm run test:coverage && npm run verify:geometry && npm run build",
    "benchmark:proteingym": "tsx tools/run_proteingym_benchmark.ts",
    "review": "tsx scripts/review.ts review",
    "review:preview": "tsx scripts/review.ts review --preview",
    "review:scan": "tsx scripts/review.ts scan",
    "migrate:rasp": "tsx scripts/build-rasp-sqlite.ts",
    "graft": "node tools/graft/cli.cjs",
    "search": "zg query",
    "search:index": "zg index --embedding local/potion-code-16m-v2",
    "search:status": "zg status"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@gmod/bgzf-filehandle": "^6.2.0",
    "@gmod/tabix": "^3.4.2",
    "@google/genai": "^2.4.0",
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-table": "^9.1.2",
    "@vitejs/plugin-react": "^5.0.4",
    "bullmq": "^6.0.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "compression": "^1.8.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.1",
    "lucide-react": "^0.546.0",
    "molstar": "^5.10.1",
    "motion": "^12.23.24",
    "piscina": "^5.3.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@alibaba-group/open-code-review": "^1.11.2",
    "@nanonets/graft": "^0.16.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@zvec/zvec-grep": "^0.2.2",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "sass": "^1.101.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
